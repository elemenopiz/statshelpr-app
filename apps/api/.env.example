# === LLM provider (Gemini 3.5 Flash) ===
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === R execution (only if using Vercel Sandbox path — WebR client-side needs neither) ===
R_SANDBOX_SNAPSHOT_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# === Lemon Squeezy (license validation) ===
# If LEMONSQUEEZY_API_KEY is unset, the API runs ungated for local dev.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=

# === Internal metrics dashboard (/dashboard) ===
# Server-only — never exposed to the client bundle.
# METRICS_API_URL/METRICS_TOKEN: the dashboard fetches GET {METRICS_API_URL}/api/metrics
# from the Cloudflare Worker with `Authorization: Bearer {METRICS_TOKEN}`.
# Defaults to https://api.statshelpr.com if unset; the token has no default
# and must be set for the live (non-?demo=1) view to work.
METRICS_API_URL=https://api.statshelpr.com
METRICS_TOKEN=
# DASHBOARD_PASSWORD: access gate for /dashboard (enforced in proxy.ts).
# Visit /dashboard?key=<this value> once; a short-lived cookie then covers
# subsequent navigation. Unset = /dashboard is fully locked for everyone,
# including ?demo=1 — set this before relying on the page at all.
DASHBOARD_PASSWORD=
