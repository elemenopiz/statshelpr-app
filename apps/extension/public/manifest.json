{
  "manifest_version": 3,
  "name": "statshelpr",
  "version": "1.1.2",
  "description": "Stats quiz tutor — suggests the answer on your quiz questions, with the R code behind it in the extension popup.",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://quizzes.next.instructure.com/*",
    "https://api.statshelpr.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "statshelpr",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/modules/*",
        "https://quizzes.next.instructure.com/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://statshelpr.com/*", "https://www.statshelpr.com/*"],
      "js": ["activate.js"],
      "run_at": "document_idle"
    }
  ]
}
