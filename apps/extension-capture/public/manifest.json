{
  "manifest_version": 3,
  "name": "statshelpr — Data Capture (DEV)",
  "version": "0.1.0",
  "description": "DEV-ONLY sideload tool: capture labeled Canvas quiz questions as eval/training fixtures. Not for distribution.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://quizzes.next.instructure.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "statshelpr · capture (DEV)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/modules/*",
        "https://quizzes.next.instructure.com/*"
      ],
      "js": ["capture-content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
